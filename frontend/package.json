{
  "name": "textfsm-editor",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "licenses": "node scripts/generate-third-party-notices.mjs",
    "licenses:monaco": "node scripts/generate-third-party-notices.mjs --sync-monaco",
    "vendor:ntc": "node scripts/vendor-ntc.mjs",
    "assets:ntc": "node scripts/generate-ntc-assets.mjs",
    "dev": "vite",
    "build": "npm run assets:ntc && npm run typecheck && vite build",
    "build:deploy": "npm run build && npm run deploy",
    "deploy": "node scripts/deploy.mjs",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "format": "biome format ./src",
    "format:fix": "biome format --write ./src",
    "typecheck": "tsc -b",
    "check": "npm run typecheck && biome check ./src",
    "check:fix": "biome check --write ./src && npm run typecheck",
    "preview": "vite preview",
    "test": "vitest"
  },
  "dependencies": {
    "@mantine/code-highlight": "^9.7.3",
    "@mantine/core": "^9.7.3",
    "@mantine/dropzone": "^9.7.3",
    "@mantine/hooks": "^9.7.3",
    "@monaco-editor/react": "^4.8.0-rc.3",
    "clsx": "^2.1.1",
    "fuse.js": "^7.5.0",
    "globals": "^17.13.0",
    "jotai": "^3.0.1",
    "lucide-react": "^1.61.0",
    "mantine-datatable": "^9.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.14.8",
    "shiki": "^4.5.0",
    "txtfsm": "^0.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
